#!/bin/sh
# glide-click X Y [STEPS] [move]
#
# Ease the REAL X cursor from its current position to X,Y (device pixels on
# the Xvfb display), then left-click. With a 4th arg "move", glide only and
# skip the click (useful for triggering :hover).
#
# Why this exists: CDP Input.dispatchMouseEvent injects synthetic events that
# skip parts of the native input path — some :hover states, CSS transitions,
# and HTML5 drag never fire. xdotool moves the actual X pointer, so Chromium
# sees genuine OS input. And the cursor visibly travels across the screen, so
# anyone watching the noVNC viewer sees the agent "use" the page like a human.
set -e
export DISPLAY=:99

TX="$1"; TY="$2"; STEPS="${3:-25}"; MODE="$4"
if [ -z "$TX" ] || [ -z "$TY" ]; then
  echo "usage: glide-click X Y [steps] [move]" >&2
  exit 1
fi

# Current pointer position -> X, Y, SCREEN, WINDOW
eval "$(xdotool getmouselocation --shell)"
SX="$X"; SY="$Y"

i=1
while [ "$i" -le "$STEPS" ]; do
  CX=$(( SX + (TX - SX) * i / STEPS ))
  CY=$(( SY + (TY - SY) * i / STEPS ))
  xdotool mousemove "$CX" "$CY"
  sleep 0.01
  i=$(( i + 1 ))
done

xdotool mousemove "$TX" "$TY"
[ "$MODE" = "move" ] || xdotool click 1
